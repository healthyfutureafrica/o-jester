# ---------------------------------------------------------------------------
# O-Jester server configuration. Copy to .env and fill in.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public URL of the web app (used for payment redirects) and of this API (webhooks)
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
DATABASE_URL="file:./dev.db"
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
APP_TIMEZONE=Africa/Douala

# --- Match data (REQUIRED — real-world fixtures only) -------------------------
# api-football  : all 37 leagues + bookmaker odds (recommended for production)
# football-data : free key, 12 top competitions, no odds
FOOTBALL_PROVIDER=api-football
# https://dashboard.api-football.com  (recommended: covers all leagues + bookmaker odds)
API_FOOTBALL_KEY=
# Bookmaker id for odds (8 = Bet365, 1 = 10Bet, 6 = Bwin ...)
API_FOOTBALL_BOOKMAKER=8
# https://www.football-data.org/client/register  (free tier: 12 competitions, no odds)
FOOTBALL_DATA_KEY=

# --- AI analysis (Claude) ----------------------------------------------------
# https://platform.claude.com — leave empty to run on the statistical model only
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Let Claude search the web for team news (injuries, suspensions, line-ups)
AI_WEB_SEARCH=true
# Cap on fixtures analysed per refresh run (controls API spend)
AI_MAX_MATCH_ANALYSES_PER_RUN=20

# --- Payments ----------------------------------------------------------------
# true = no live settlement; uses ENKAP staging when configured, otherwise the local mock
PAYMENTS_SANDBOX=true
# ENKAP staging API. Copy this file to .env and provide your own credentials.
ENKAP_API_BASE_URL=https://api.enkap-staging.maviance.info/purchase/v1.2
ENKAP_TOKEN_URL=https://api.enkap-staging.maviance.info/token
ENKAP_ACCESS_TOKEN=
ENKAP_CONSUMER_KEY=
ENKAP_CONSUMER_SECRET=
# Optional if required by your ENKAP account
ENKAP_API_KEY=
ENKAP_API_SECRET=
# Flutterwave: Mobile Money (MTN/Orange, XAF) + cards — https://dashboard.flutterwave.com
FLUTTERWAVE_SECRET_KEY=
# The "secret hash" you set under Settings > Webhooks; webhook URL: {API_URL}/api/payments/webhooks/flutterwave
FLUTTERWAVE_WEBHOOK_HASH=
# PayPal REST app — https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# Webhook URL: {API_URL}/api/payments/webhooks/paypal (events: CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED)
PAYPAL_WEBHOOK_ID=
# PayPal can't settle XAF: EUR uses the fixed CFA peg (655.957), USD uses XAF_PER_USD
PAYPAL_CURRENCY=EUR
XAF_PER_USD=600

# --- Jobs --------------------------------------------------------------------
ENABLE_SCHEDULER=true
FULL_REFRESH_CRON=5 */3 * * *
SCORES_CRON=*/15 * * * *
