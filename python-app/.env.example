# ---------------------------------------------------------------------------
# O-Jester configuration. Copy this file to .env and fill it in.
# ---------------------------------------------------------------------------
APP_ENV=development
# Generate with: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
# Public address of the site (used for payment redirects)
APP_URL=http://localhost:5080
APP_TIMEZONE=Africa/Douala
# Optional: defaults to SQLite in ./instance/ojester.db  (PostgreSQL: postgresql+psycopg://user:pass@host/db)
DATABASE_URL=

# --- Real match data (REQUIRED) ---------------------------------------------
# api-football  : all 37 leagues + bookmaker odds (recommended) — https://dashboard.api-football.com
# football-data : free key, 12 top competitions, no odds       — https://www.football-data.org/client/register
FOOTBALL_PROVIDER=api-football
API_FOOTBALL_KEY=
API_FOOTBALL_BOOKMAKER=8
FOOTBALL_DATA_KEY=

# --- Optional AI analyst (Claude) -------------------------------------------
# Leave empty: the whole app works on the statistical model alone.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_WEB_SEARCH=true
AI_MAX_MATCH_ANALYSES_PER_RUN=20

# --- Payments ---------------------------------------------------------------
# true = simulated checkout, no money moves (default outside production)
PAYMENTS_SANDBOX=true
# Flutterwave: MTN MoMo / Orange Money (XAF) + cards — https://dashboard.flutterwave.com
FLUTTERWAVE_SECRET_KEY=
# Webhook URL: {APP_URL}/api/payments/webhooks/flutterwave ; same "secret hash" here:
FLUTTERWAVE_WEBHOOK_HASH=
# PayPal REST app — https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# Webhook URL: {APP_URL}/api/payments/webhooks/paypal (CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED)
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=EUR
XAF_PER_USD=600

# --- Background jobs (cron syntax, APP_TIMEZONE) ----------------------------
ENABLE_SCHEDULER=true
FULL_REFRESH_CRON=5 */3 * * *
SCORES_CRON=*/15 * * * *

# --- Beta test version (for friends testing online) -------------------------
# Shows a "test version" banner + feedback button, hides the site from search engines,
# and gives every new account a free trial so testers can try all features.
BETA_MODE=false
BETA_TRIAL_PLAN=ELITE
BETA_TRIAL_DAYS=14

# Optional: admin account created/updated automatically at start-up (needed on hosts without a shell)
ADMIN_EMAIL=
ADMIN_PASSWORD=
