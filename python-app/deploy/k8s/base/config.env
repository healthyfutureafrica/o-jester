APP_ENV=production
APP_TIMEZONE=Africa/Douala
PORT=5080
FOOTBALL_PROVIDER=api-football
API_FOOTBALL_BOOKMAKER=8
AI_MODEL=claude-opus-5-5
AI_WEB_SEARCH=true
AI_MAX_MATCH_ANALYSES_PER_RUN=20
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=EUR
XAF_PER_USD=600
PAYMENTS_SANDBOX=true
BETA_MODE=false
BETA_TRIAL_PLAN=ELITE
BETA_TRIAL_DAYS=14
# Background jobs run as Kubernetes CronJobs (exactly once), never inside web pods.
ENABLE_SCHEDULER=false
# Tables are created by the init container, not by every web pod at start-up.
DB_AUTO_CREATE=false
