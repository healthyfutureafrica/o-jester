# Template for the `o-jester-secrets` Secret. Copy to secrets.<env>.env (git-ignored),
# fill in, then:  kubectl -n <namespace> create secret generic o-jester-secrets --from-env-file=secrets.<env>.env
# Generate SECRET_KEY with: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
# Staging (in-cluster PostgreSQL): postgresql://ojester:<POSTGRES_PASSWORD>@o-jester-postgres:5432/ojester
# Production: your managed database URL (add ?sslmode=require if your provider needs it)
DATABASE_URL=
API_FOOTBALL_KEY=
FOOTBALL_DATA_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ANTHROPIC_API_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
